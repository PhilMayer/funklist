# Copy to server/.env and fill in.

# OAuth 2.0 Client ID (type "Web application") from https://console.cloud.google.com/apis/credentials
# Leave empty to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure
# (defaults to on when NODE_ENV=production).
# COOKIE_SECURE=1

# Time zone for bands created without one (IANA name). Defaults to this machine's zone.
# DEFAULT_TIMEZONE=America/New_York

# Public URL of the site, used for links in emails and by `npm run invite`.
# APP_URL=http://localhost:3001

# ---- Email (new-event notifications) ----
# Any SMTP provider works. Leave SMTP_HOST empty to log emails to the console instead of sending.
#
# Gmail: turn on 2-Step Verification, create an App Password (https://myaccount.google.com/apppasswords),
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
# Resend (needs a verified domain): SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails. Gmail requires this to be your Gmail address.
MAIL_FROM="Funklist <you@example.com>"

