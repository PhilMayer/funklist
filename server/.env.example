# Copy to server/.env and fill in.

# OAuth 2.0 Client ID (type "Web application") from https://console.cloud.google.com/apis/credentials
# Leave empty to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure
# (defaults to on when NODE_ENV=production).
# COOKIE_SECURE=1

# Public URL used by `npm run invite` when printing links.
# APP_URL=http://localhost:3001
